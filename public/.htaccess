# sporten.app op Versio (Apache). Dit bestand gaat met de deploy mee naar de webroot en
# vervangt een eventuele .htaccess die daar stond; daarom staat de https-doorverwijzing
# hier zelf in, zodat die niet verdwijnt als hij eerder uit zo'n bestand kwam.

# Eigen foutpagina in plaats van de kale Apache-pagina.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.sporten.app -> sporten.app (één adres voor zoekmachines en gedeelde links).
  # Werkt via http; https op www vraagt eerst een certificaat dat www dekt.
  RewriteCond %{HTTP_HOST} ^www\.sporten\.app$ [NC]
  RewriteRule ^ https://sporten.app%{REQUEST_URI} [L,R=301]

  # Altijd https. De tweede voorwaarde voorkomt een lus als een proxy de TLS afhandelt.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
