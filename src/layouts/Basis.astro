---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/global.css';
import { organisatie } from '../data/structured';
import paginas from '../../design/og/paginas.json';

interface Props {
  titel: string;
  beschrijving: string;
  // Voor de 404-pagina: niet indexeren en geen canonical.
  geenIndex?: boolean;
  // 'article' voor kennisbankartikelen; de rest is 'website'.
  ogType?: 'website' | 'article';
}
const { titel, beschrijving, geenIndex = false, ogType = 'website' } = Astro.props;
const jaar = new Date().getFullYear();
// Op productie '/'; bij PR-previews het subpad op GitHub Pages (zie astro.config.mjs).
const basis = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Deelafbeelding: een eigen afbeelding per pagina als die bestaat (public/img/og/<slug>.png,
// gemaakt met design/og/maak-og.cjs), anders de algemene. Absoluut en altijd op het
// productiedomein, zodat een gedeelde link overal werkt.
const pad = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/?$/, '/').length - 1);
const slug = pad.replace(/^\/|\/$/g, '').replace(/\//g, '-');
const eigen = slug !== '' && existsSync(join(process.cwd(), 'public', 'img', 'og', `${slug}.png`));
// The general image lives under its own name: /img/og.png is cached by the platforms with the
// image of the old site, and a new URL is the only reliable way past those caches.
const ogAfbeelding = new URL(eigen ? `/img/og/${slug}.png` : '/img/og/algemeen.png', Astro.site).href;
// The alt text describes what the image shows: the heading on it, from the same paginas.json.
const kaart = paginas.find((p) => p.pad === pad.replace(/^\//, ''));
const ogAlt = eigen && kaart ? `${kaart.kop}. ${kaart.sub}` : 'Sporten.app: de hele administratie van je sportvereniging, van aanmelding tot jaarrekening';
const siteData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    organisatie,
    { '@type': 'WebSite', '@id': 'https://sporten.app/#website', name: 'Sporten.app', url: 'https://sporten.app/', inLanguage: 'nl', publisher: { '@id': 'https://sporten.app/#organisatie' } },
  ],
});
---

<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={beschrijving} />
  <meta name="author" content="Sporten.app" />
  <title>{titel}</title>
  <link rel="icon" type="image/png" href={`${basis}img/icon.png`} />
  {geenIndex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <link rel="sitemap" href={`${basis}sitemap.xml`} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Sporten.app" />
  <meta property="og:locale" content="nl_NL" />
  <meta property="og:title" content={titel} />
  <meta property="og:description" content={beschrijving} />
  {!geenIndex && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogAfbeelding} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt} />
  <meta property="og:image:type" content="image/png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titel} />
  <meta name="twitter:description" content={beschrijving} />
  <meta name="twitter:image" content={ogAfbeelding} />
  <meta name="twitter:image:alt" content={ogAlt} />
  <script type="application/ld+json" set:html={siteData} />
  <slot name="kop" />
</head>
<body>
  <header class="site">
    <div class="container nav">
      <a class="logo" href={basis}>sporten<em>.app</em></a>
      <input type="checkbox" id="menu" class="menu-check" aria-label="Menu openen" />
      <label for="menu" class="hamburger" aria-hidden="true"><span></span><span></span><span></span></label>
      <div class="links">
        <ul>
          <li><a href={`${basis}functies/`}>Functies</a></li>
          <li><a href={`${basis}prijzen/`}>Prijzen</a></li>
          <li><a href={`${basis}avg/`}>AVG</a></li>
          <li><a href={`${basis}#vragen`}>Vragen</a></li>
          <li><a href={`${basis}#contact`}>Contact</a></li>
        </ul>
        <details class="login">
          <summary>Inloggen</summary>
          <div class="keuze">
            <a href="https://app.sporten.app"><b>Voor leden</b><small>De app: agenda en aanmelden</small></a>
            <a href="https://portal.sporten.app"><b>Voor bestuur</b><small>Beheerportaal; leden dienen hier ook declaraties in</small></a>
          </div>
        </details>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <div class="container">
      <span>© {jaar} Sporten.app · LightMedia, Waddinxveen · KvK 59466618</span>
      <a href={`${basis}privacy/`}>Privacy</a>
      <a href={`${basis}voorwaarden/`}>Voorwaarden</a>
      <a href={`${basis}avg/`}>AVG</a>
      <a href={`${basis}verwerkersovereenkomst/`}>Verwerkersovereenkomst</a>
    </div>
  </footer>
</body>
</html>
