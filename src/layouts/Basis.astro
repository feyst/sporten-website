---
import '../styles/global.css';

interface Props {
  titel: string;
  beschrijving: string;
}
const { titel, beschrijving } = Astro.props;
const jaar = new Date().getFullYear();
// Op productie '/'; bij PR-previews het subpad op GitHub Pages (zie astro.config.mjs).
const basis = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Absoluut en altijd op het productiedomein, zodat een gedeelde link overal werkt.
const ogAfbeelding = new URL('/img/og.png', Astro.site).href;
---

<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={beschrijving} />
  <meta name="author" content="Sporten.app" />
  <title>{titel}</title>
  <link rel="icon" type="image/png" href={`${basis}img/icon.png`} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href={`${basis}sitemap.xml`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sporten.app" />
  <meta property="og:locale" content="nl_NL" />
  <meta property="og:title" content={titel} />
  <meta property="og:description" content={beschrijving} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogAfbeelding} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Sporten.app — ledenadministratie voor uw sportclub, met een telefoon die de activiteitenagenda toont" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titel} />
  <meta name="twitter:description" content={beschrijving} />
  <meta name="twitter:image" content={ogAfbeelding} />
  <slot name="kop" />
</head>
<body>
  <header class="site">
    <div class="container nav">
      <a class="logo" href={basis}>sporten<em>.app</em></a>
      <input type="checkbox" id="menu" class="menu-check" aria-label="Menu openen" />
      <label for="menu" class="hamburger" aria-hidden="true"><span></span><span></span><span></span></label>
      <div class="links">
        <ul>
          <li><a href={`${basis}#functies`}>Functies</a></li>
          <li><a href={`${basis}#hoe`}>Hoe het werkt</a></li>
          <li><a href={`${basis}#vragen`}>Vragen</a></li>
          <li><a href={`${basis}#contact`}>Contact</a></li>
          <li><a href={`${basis}privacy`}>Privacy</a></li>
        </ul>
        <details class="login">
          <summary>Inloggen</summary>
          <div class="keuze">
            <a href="https://app.sporten.app"><b>Voor leden</b><small>Open de app — agenda en aanmelden</small></a>
            <a href="https://portal.sporten.app"><b>Voor bestuur</b><small>Beheerportaal — leden en activiteiten</small></a>
          </div>
        </details>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <div class="container">
      <span>© {jaar} Sporten.app</span>
      <a href={`${basis}privacy`}>Privacy</a>
      <a href={`${basis}voorwaarden`}>Voorwaarden</a>
      <a href={`${basis}verwerkersovereenkomst`}>Verwerkersovereenkomst</a>
      <a href="https://github.com/feyst/sporten-website">GitHub</a>
    </div>
  </footer>
</body>
</html>
