---
import Basis from './Basis.astro';

// Schil om de juridische pagina's die als Markdown in src/pages staan
// (verwerkersovereenkomst, subverwerkers, voorwaarden, privacy). Diezelfde Markdown is
// de bron voor de pdf in public/documenten/ — één bron, dus de gepubliceerde en de
// verstuurde versie kunnen niet uit elkaar lopen. Zie de README.
interface Props {
  frontmatter: {
    titel: string;
    beschrijving: string;
    versie?: string;
    datum?: string;
  };
}
const { frontmatter } = Astro.props;
---

<Basis titel={frontmatter.titel} beschrijving={frontmatter.beschrijving}>
  <div class="container proza juridisch">
    <p class="merk" aria-hidden="true">sporten<em>.app</em></p>
    <slot />
    {
      frontmatter.versie && frontmatter.datum && (
        <p class="versie">
          <i>Versie {frontmatter.versie} — {frontmatter.datum}.</i>
        </p>
      )
    }
  </div>
</Basis>

<style>
  .juridisch :global(h1 span) {
    color: var(--rood);
  }
  .versie {
    margin-top: 40px;
  }
</style>
