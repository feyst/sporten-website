---
import Basis from '../layouts/Basis.astro';
import FinancienScherm from '../components/FinancienScherm.astro';
import ChatTelefoon from '../components/ChatTelefoon.astro';
import StoreBadges from '../components/StoreBadges.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import { software } from '../data/structured';

const basis = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

// Eén bron voor de vragen: hieruit komt zowel de zichtbare FAQ als de FAQPage-markup.
// Google eist dat die twee gelijk zijn, en dat blijven ze alleen als ze niet twee keer
// zijn overgetypt. De antwoorden mogen HTML bevatten; die gaat naar beide kanten.
const vragen = [
  {
    vraag: 'Wat kost Sporten.app?',
    antwoord: `Je betaalt naar het aantal leden: € 149 per jaar tot 100 leden, € 299 tot 300 leden en € 549 tot 750 leden, inclusief btw. Studenten- en schoolsportverenigingen krijgen 40% korting. Zie <a href="${basis}prijzen/">de prijzen</a>.`,
  },
  {
    vraag: 'Moeten we alles gebruiken?',
    antwoord:
      'Nee. Je kunt beginnen met de ledenlijst en de agenda, en de boekhouding later aanzetten. De prijs blijft gelijk.',
  },
  {
    vraag: 'Kunnen we de contributie incasseren?',
    antwoord:
      'Ja. Leden geven de machtiging zelf in de app, of je legt een papieren machtiging vast. Sporten.app maakt het incassobestand en jij levert het aan bij je bank; daarvoor heb je een incassocontract met je bank nodig. Incasseer je al via een ander pakket, dan neem je je bestaande machtigingen mee.',
  },
  {
    vraag: 'Kunnen we midden in het boekjaar overstappen?',
    antwoord:
      'Ja. We zetten je lopende boekjaar over, zonder meerprijs. Je boekjaar mag ook op een andere datum dan 1 januari beginnen, bijvoorbeeld op 1 september.',
  },
  {
    vraag: 'Hoe komen onze leden erin?',
    antwoord:
      'Stuur ons je ledenlijst als spreadsheet, dan zetten wij hem over. Je leden krijgen daarna een mail waarmee ze inloggen. Nieuwe leden melden zich voortaan aan via het aanmeldformulier van je vereniging, en het bestuur keurt de aanmelding goed. Ouders melden hun kinderen mee aan.',
  },
  {
    vraag: 'Werkt de app op iPhone en Android?',
    antwoord:
      'Ja. De app staat in Google Play en de App Store, en werkt ook in de browser op elk toestel.',
  },
  {
    vraag: 'Wie mag wat zien?',
    antwoord:
      'Dat bepaal je zelf met rollen. De penningmeester ziet de boekhouding, een trainer zijn deelnemers en de kascommissie het boekjaar dat ze controleert. Elke wijziging aan een rol komt in een logboek.',
  },
  {
    vraag: 'Hoe zit het met de AVG?',
    antwoord: `Je vereniging is verantwoordelijk voor de gegevens van haar leden; wij verwerken ze in haar opdracht. Daarvoor sluiten we een verwerkersovereenkomst, die je vooraf kunt lezen. De gegevens staan binnen de Europese Economische Ruimte. Lees <a href="${basis}avg/">wat wij regelen en wat jij regelt</a>.`,
  },
  {
    vraag: 'Wie zit er achter Sporten.app?',
    antwoord:
      'Sporten.app is een product van LightMedia in Waddinxveen (KvK 59466618). Je vragen beantwoorden we zelf, per mail of WhatsApp.',
  },
];

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    software,
    {
      '@type': 'FAQPage',
      mainEntity: vragen.map((v) => ({
        '@type': 'Question',
        name: v.vraag,
        acceptedAnswer: { '@type': 'Answer', text: v.antwoord },
      })),
    },
  ],
});
---

<Basis
  titel="Ledenadministratie en boekhouding voor sportverenigingen | Sporten.app"
  beschrijving="Ledenadministratie, contributie en incasso, boekhouding en declaraties voor je sportvereniging, met een app voor je leden. Vanaf € 149 per jaar."
>
  <script type="application/ld+json" slot="kop" set:html={structuredData} />

  <div class="hero">
    <div class="container">
      <div>
        <h1>De hele administratie van je sportvereniging.<br /><span>Van aanmelding tot jaarrekening.</span></h1>
        <p>
          Ledenadministratie, contributie, boekhouding, declaraties en vrijwilligersvergoedingen in één systeem, met een app
          waarin je leden zich met één tik inschrijven. Je krijgt alle functies en betaalt alleen naar het
          aantal leden.
        </p>
        <div class="cta-rij">
          <a class="knop" href={`${basis}prijzen/`}>Bekijk de prijzen</a>
          <a class="knop rand" href="#functies">Wat zit erin?</a>
        </div>
      </div>
      <div class="hero-beeld">
        <FinancienScherm />
      </div>
    </div>
  </div>

  <section class="vlak" id="probleem">
    <div class="container">
      <span class="lint">Herkenbaar?</span>
      <h2>Vier plekken, één vrijwilliger, geen overdracht</h2>
      <p class="sectie-intro">
        Het ledenbestand in Excel, de contributie in de bank, de bonnen in WhatsApp en de agenda in een
        appgroep. Zolang dezelfde persoon het doet, gaat het goed. Daarna niet meer.
      </p>
      <div class="kaarten">
        <div class="kaart">
          <h3>Excel, een schoenendoos en een avond per maand</h3>
          <p>
            Bonnen komen binnen via WhatsApp. Contributie factureer je met de hand en vink je af tegen het
            bankafschrift.
          </p>
        </div>
        <div class="kaart">
          <h3>De vorige penningmeester is verhuisd</h3>
          <p>
            Het bestand stond op zijn laptop. Bij studentenverenigingen gebeurt dit elk jaar: de opvolger
            begint met archeologie in plaats van met besturen.
          </p>
        </div>
        <div class="kaart">
          <h3>&ldquo;Kun je laten zien waar dit vandaan komt?&rdquo;</h3>
          <p>
            In Excel ziet de kascommissie het eindresultaat, maar niet wat er eerder stond. Controleren wordt
            dan een kwestie van vertrouwen.
          </p>
        </div>
        <div class="kaart">
          <h3>Het ledenbestand gaat rond per mail</h3>
          <p>
            Namen, adressen en geboortedata van jeugdleden in een spreadsheet die van mailbox naar mailbox
            gaat. Wie er allemaal een kopie van heeft, weet niemand meer.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="functies">
    <div class="container">
      <span class="lint">Functies</span>
      <h2>Eén systeem voor de hele vereniging</h2>
      <p class="sectie-intro">
        De ledenlijst, de boekhouding en de app werken met hetzelfde ledenbestand. Je houdt niets twee keer bij.
      </p>
      <div class="kaarten">
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
          <h3>Ledenadministratie</h3>
          <p>Nieuwe leden melden zich aan via een formulier en jij keurt goed. Je werkt met lidsoorten en gezinnen, en zet een oud-lid zo weer terug in de ledenlijst.</p>
          <p class="verder"><a href={`${basis}functies/ledenadministratie/`}>Ledenadministratie →</a></p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/></svg></div>
          <h3>Contributie en incasso</h3>
          <p>Contributiefacturen per mail, herinneringen en automatische incasso. Leden geven de machtiging zelf in de app.</p>
          <p class="verder"><a href={`${basis}functies/contributie/`}>Contributie en incasso →</a></p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg></div>
          <h3>Boekhouding</h3>
          <p>Dubbel boekhouden met grootboek, doorlopende nummering, balans en baten en lasten. Je boekjaar begint op de datum die bij je vereniging past.</p>
          <p class="verder"><a href={`${basis}functies/boekhouding/`}>Boekhouding voor je vereniging →</a></p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 2v20l3-2 3 2 3-2 3 2 3-2V2l-3 2-3-2-3 2-3-2z"/><path d="M9 9h6M9 13h4"/></svg></div>
          <h3>Declaraties</h3>
          <p>Een lid stuurt een foto van de bon mee. Zet je automatisch uitlezen aan, dan staan winkel, datum en bedrag al ingevuld. Jij keurt goed en de boeking staat klaar.</p>
          <p class="verder"><a href={`${basis}functies/declaraties/`}>Declaraties →</a></p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.5 5.5 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.5A2 2 0 0 0 16.7 4H7.3a2 2 0 0 0-1.8 1.5z"/></svg></div>
          <h3>Inkoopfacturen</h3>
          <p>Leveranciers mailen hun factuur naar een eigen adres van je vereniging. Je vindt hem terug als concept, klaar om te controleren en te boeken.</p>
          <p class="verder"><a href={`${basis}functies/declaraties/`}>Inkoopfacturen →</a></p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
          <h3>Vrijwilligersvergoeding voor trainers</h3>
          <p>De uren komen uit de agenda, het tarief stel je per trainer in. De trainer kijkt zijn afrekening zelf na, en je krijgt een seintje als een vergoeding boven de vrijwilligersgrens komt.</p>
          <p class="verder"><a href={`${basis}functies/vrijwilligersvergoeding/`}>Vrijwilligersvergoeding →</a></p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9v9z"/><path d="M15.5 3.5A9 9 0 0 1 20.5 8.5L12 12z"/></svg></div>
          <h3>Kostenplaatsen en begroting</h3>
          <p>Wat heeft het toernooi echt gekost? Kosten en opbrengsten per kostenplaats, een begroting waarop je ziet of je op koers ligt, en een rapport in pdf.</p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></div>
          <h3>Rollen en rechten</h3>
          <p>Kant-en-klare rollen voor penningmeester, secretaris, bestuur en kascommissie. Bij een bestuurswissel geef je de rol door, en een logboek houdt bij wie wat kreeg.</p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/></svg></div>
          <h3>De app voor je leden</h3>
          <p>Agenda, inschrijven met één tik, chat per activiteit en een pushmelding als er iets verandert. Op iPhone, Android en in de browser.</p>
          <p class="verder"><a href={`${basis}functies/ledenapp/`}>De ledenapp →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="vlak" id="voor-wie">
    <div class="container">
      <span class="lint">Voor wie</span>
      <h2>Wat het verandert voor je bestuur en trainers</h2>
      <p class="sectie-intro">
        Gemaakt voor sportverenigingen met vrijwilligers in het bestuur: hardlopen, triatlon, zwemmen, roeien, studentensport en meer.
      </p>
      <div class="kaarten">
        <div class="kaart">
          <h3>De penningmeester</h3>
          <p>
            Bonnen komen binnen als declaratie in plaats van als appje. Je leest het bankafschrift in en Sporten.app
            stelt bij elke betaling de factuur voor. Doe je dat geregeld, dan zijn balans en baten en lasten
            steeds bij en hoef je aan het eind van het jaar niets meer bij elkaar te zoeken.
          </p>
        </div>
        <div class="kaart">
          <h3>De secretaris</h3>
          <p>
            Eén ledenbestand, ook als het bestuur wisselt. Je bepaalt wie wat mag zien, en de
            verwerkersovereenkomst ligt al klaar.
          </p>
        </div>
        <div class="kaart">
          <h3>De trainer</h3>
          <p>
            Zijn deelnemerslijst op zijn telefoon, één bericht naar de hele groep als het regent, en een
            afrekening van zijn uren die hij zelf nakijkt.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="vertrouwen">
    <div class="container">
      <span class="lint">AVG</span>
      <h2>Privacy die je kunt nalezen</h2>
      <p class="sectie-intro">
        Wat we met de gegevens van je leden doen, lees je na in de verwerkersovereenkomst, de
        privacyverklaring en de lijst van bedrijven die we inschakelen.
      </p>
      <div class="zegels">
        <a class="zegel" href={`${basis}avg/`}>
          <span class="zegelicoon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></span>
          <span>
            <b>Verwerkersovereenkomst klaar</b>
            <small>Opslag in Europa (EER), op apparatuur die we zelf beheren</small>
            <span class="verder">Wat wij regelen en wat jij regelt →</span>
          </span>
        </a>
        <a class="zegel" href={`${basis}avg/#geen-trackers`}>
          <span class="zegelicoon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M4.5 4.5l15 15"/></svg></span>
          <span>
            <b>Geen trackers</b>
            <small>Ook geen advertenties en geen doorverkoop van gegevens</small>
            <span class="verder">Wat we niet doen →</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="vlak" id="prijs">
    <div class="container">
      <span class="lint">Prijs</span>
      <h2>Alle functies, voor elke vereniging</h2>
      <p class="sectie-intro">
        Je betaalt naar het aantal leden dat in je ledenadministratie meetelt. Facturen en incasso’s kosten
        niets per stuk.
      </p>
      <div class="staffels">
        <div class="staffel">
          <span class="naam">Klein</span>
          <span class="omvang">t/m 100 leden</span>
          <span class="bedrag">€ 149</span>
          <span class="per">per jaar · incl. btw</span>
          <span class="incl">€ 1,49 per lid bij 100 leden</span>
        </div>
        <div class="staffel">
          <span class="naam">Vereniging</span>
          <span class="omvang">101 – 300 leden</span>
          <span class="bedrag">€ 299</span>
          <span class="per">per jaar · incl. btw</span>
          <span class="incl">€ 1,00 per lid bij 300 leden</span>
        </div>
        <div class="staffel">
          <span class="naam">Groot</span>
          <span class="omvang">301 – 750 leden</span>
          <span class="bedrag">€ 549</span>
          <span class="per">per jaar · incl. btw</span>
          <span class="incl">€ 0,73 per lid bij 750 leden</span>
        </div>
        <div class="staffel">
          <span class="naam">XL</span>
          <span class="omvang">vanaf 751 leden</span>
          <span class="bedrag">€ 0,70</span>
          <span class="per">per lid per jaar · incl. btw</span>
          <span class="incl">minimaal € 549 per jaar</span>
        </div>
      </div>
      <p class="studenten"><b>De eerste twee maanden zijn gratis.</b> Studenten- of schoolsportvereniging? Dan krijg je 40% korting. <a href={`${basis}voor/studentenverenigingen/`}>Sporten.app voor studentenverenigingen</a></p>
      <div class="cta-rij prijs-cta">
        <a class="knop" href={`${basis}prijzen/`}>Alle prijzen en voorwaarden</a>
      </div>
    </div>
  </section>

  <section id="hoe">
    <div class="container">
      <span class="lint">Overstappen</span>
      <h2>Zo stap je over</h2>
      <p class="sectie-intro">Ook midden in het boekjaar. <a href={`${basis}overstappen/`}>Lees hoe overstappen werkt</a>.</p>
      <div class="stappen">
        <div class="stap">
          <b>1</b>
          <h3>Wij richten je vereniging in</h3>
          <p>We zetten het beheerportaal voor je vereniging klaar, zodat het bestuur kan inloggen.</p>
        </div>
        <div class="stap">
          <b>2</b>
          <h3>Wij zetten je ledenlijst over</h3>
          <p>Stuur je ledenlijst als spreadsheet, dan zetten wij hem over. Je leden krijgen een mail waarmee ze inloggen.</p>
        </div>
        <div class="stap">
          <b>3</b>
          <h3>Wij zetten je boekhouding over</h3>
          <p>
            Je levert je rekeningschema, beginbalans en bankmutaties aan als spreadsheet, en wij lezen ze in.
            Je lopende boekjaar gaat zo mee. Overzetten kost niets extra.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="vlak leden" id="leden">
    <div class="container">
      <div>
        <ChatTelefoon />
      </div>
      <div>
        <h2>Voor je leden</h2>
        <p>
          Je leden zien in één app wat er te doen is en melden zich direct aan. Elke activiteit heeft een
          eigen chat, en gaat de training niet door, dan krijgt iedereen een pushmelding. Ouders melden hun
          kinderen aan vanaf hun eigen account.
        </p>
        <p>
          Ben je al lid van een vereniging die Sporten.app gebruikt? Log in, dan zie je meteen de agenda van je
          vereniging.
        </p>
        <StoreBadges />
      </div>
    </div>
  </section>

  <section class="verhaal" id="verhaal">
    <div class="container">
      <div>
        <span class="lint">Hoe het begon</span>
        <h2>Gemaakt door sporters</h2>
        <p>
          Sporten.app komt uit de triatlon. Wie zwemt, fietst en loopt, traint met verschillende groepen op
          verschillende plekken, en weet hoe snel een vereniging verdwaalt in appgroepen en inschrijflijstjes.
          Daar begon het mee: één plek waar leden zien wat er te doen is en zich met één tik aanmelden.
        </p>
        <p>
          Daarna kwam de rest. Een vereniging draait ook op een ledenlijst, contributie en een penningmeester die aan het eind van het jaar moet kunnen laten zien waar elk
          bedrag vandaan komt. Dat zit er nu allemaal in, zodat de vrijwilligers die de club draaiende houden
          er minder tijd aan kwijt zijn.
        </p>
        <h3>Je zit nergens aan vast</h3>
        <ul class="opsom">
          <li>Je gegevens neem je altijd mee: het controlepakket per boekjaar en je ledenlijst als spreadsheet.</li>
          <li>Je zegt per jaar op, zonder boete.</li>
          <li>Valt onze eigen apparatuur uit, dan draait Sporten.app door bij een tweede hostingbedrijf binnen de EU.</li>
        </ul>
      </div>
      <figure class="verhaal-beeld">
        <img
          src={`${basis}img/oorsprong-triatlon.jpg`}
          width="720" height="960" loading="lazy" decoding="async"
          alt="Een van de makers van Sporten.app loopt een triatlon in het tenue van Triathlon Team Bodegraven"
        />
        <figcaption>Foto: Triathlon Team Bodegraven</figcaption>
      </figure>
    </div>
  </section>

  <section class="vlak" id="vragen">
    <div class="container">
      <h2>Vragen</h2>
      <div class="faq">
        {
          vragen.map((v) => (
            <details>
              <summary><h3>{v.vraag}</h3></summary>
              <p set:html={v.antwoord} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="container">
      <h2>Neem contact op</h2>
      <p class="sectie-intro">
        Wil je weten of Sporten.app bij je vereniging past, of heb je een vraag over de app? Je krijgt
        persoonlijk antwoord.
      </p>
      <div class="contact-rij">
        <div class="kaart">
          <h3>E-mail</h3>
          <p><a href="mailto:info@sporten.app">info@sporten.app</a></p>
        </div>
        <div class="kaart">
          <h3>WhatsApp / telefoon</h3>
          <p><WhatsAppLink /></p>
        </div>
        <div class="kaart">
          <h3>Een half uur videobellen</h3>
          <p><a href="mailto:info@sporten.app?subject=Videobellen%20over%20Sporten.app">Plan een gesprek</a></p>
        </div>
      </div>
    </div>
  </section>
</Basis>

<style>
  /* De hero draagt een scherm in plaats van een telefoon: dat mag breder staan. */
  .hero .container { align-items: center; }
  .hero-beeld { justify-content: flex-end; }

  .kaart .verder { margin-top: 10px; font-size: 14px; }
  .kaart .verder a { color: var(--rood); font-weight: 600; }

  .studenten { margin-top: 18px; color: var(--dim); font-size: 15px; }
  .studenten a { color: var(--rood); font-weight: 600; }

