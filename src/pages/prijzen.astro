---
import Basis from '../layouts/Basis.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import { software } from '../data/structured';

const basis = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

// Eén bron voor de vragen: de zichtbare FAQ en de FAQPage-markup komen allebei hieruit,
// zodat ze niet uit elkaar kunnen lopen.
const vragen = [
  {
    vraag: 'Wat als we een deel van de functies niet gebruiken?',
    antwoord:
      'Dan betaal je hetzelfde. De boekhouding staat klaar voor het moment dat je penningmeester eraan toe is.',
  },
  {
    vraag: 'Zitten er kosten per factuur of per incasso bij?',
    antwoord:
      'Nee. Je maakt zoveel facturen, incasso’s en betaalbestanden als je wilt. Wat je bank rekent voor een incasso of overboeking, betaal je aan je bank.',
  },
  {
    vraag: 'Wat gebeurt er met onze gegevens als we stoppen?',
    antwoord:
      'Je neemt alles mee. Per boekjaar download je het controlepakket met alle boekingen, grootboekkaarten, facturen, bankmutaties en de bonnen en afschriften die erbij horen. Je ledenlijst exporteer je als spreadsheet. Na opzegging krijg je de gegevens op verzoek van ons, en daarna verwijderen we ze.',
  },
  {
    vraag: 'Hoe lang zitten we eraan vast?',
    antwoord: 'Het abonnement loopt per kalenderjaar. Wil je stoppen, dan zeg je op tegen het einde van het jaar, zonder boete.',
  },
  {
    vraag: 'We zijn een kleine vereniging met 40 leden. Is dit niet te zwaar?',
    antwoord:
      'Nee. Je begint met de ledenlijst en de agenda, en zet de boekhouding aan als je hem nodig hebt. Je betaalt € 149 per jaar, inclusief btw.',
  },
];

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    software,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sporten.app/' },
        { '@type': 'ListItem', position: 2, name: 'Prijzen', item: 'https://sporten.app/prijzen/' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: vragen.map((v) => ({
        '@type': 'Question',
        name: v.vraag,
        acceptedAnswer: { '@type': 'Answer', text: v.antwoord },
      })),
    },
  ],
});
---

<Basis
  titel="Prijzen: vanaf € 149 per jaar voor je vereniging | Sporten.app"
  beschrijving="Wat kost ledenadministratie en boekhouding voor je sportvereniging? Vanaf € 149 per jaar inclusief btw, met alle functies in elke staffel."
>
  <script type="application/ld+json" slot="kop" set:html={structuredData} />

  <div class="container kopblok"><div class="lees">
    <h1>Wat kost Sporten.app?</h1>
    <p>Je krijgt alle functies, in elke staffel. Wat je betaalt, hangt alleen af van het aantal leden. Alle bedragen zijn inclusief btw.</p>
  </div></div>

  <section id="staffels">
    <div class="container">
      <div class="staffels">
        <div class="staffel">
          <p class="naam">Klein</p>
          <p class="omvang">t/m 100 leden</p>
          <p class="bedrag">€ 149</p>
          <p class="per">per jaar · incl. btw</p>
          <div class="incl">
            <span>€ 1,49 per lid bij 100 leden</span>
          </div>
        </div>
        <div class="staffel">
          <p class="naam">Vereniging</p>
          <p class="omvang">101 – 300 leden</p>
          <p class="bedrag">€ 299</p>
          <p class="per">per jaar · incl. btw</p>
          <div class="incl">
            <span>€ 1,00 per lid bij 300 leden</span>
          </div>
        </div>
        <div class="staffel">
          <p class="naam">Groot</p>
          <p class="omvang">301 – 750 leden</p>
          <p class="bedrag">€ 549</p>
          <p class="per">per jaar · incl. btw</p>
          <div class="incl">
            <span>€ 0,73 per lid bij 750 leden</span>
          </div>
        </div>
        <div class="staffel">
          <p class="naam">XL</p>
          <p class="omvang">vanaf 751 leden</p>
          <p class="bedrag">€ 0,70</p>
          <p class="per">per lid per jaar · incl. btw</p>
          <div class="incl">
            <span>minimaal € 549 per jaar</span>
          </div>
        </div>
      </div>

      <div class="aandacht">
        <p><b>De eerste twee maanden zijn gratis.</b> Je werkt meteen met je eigen leden en je eigen boekhouding, en betaalt pas daarna.</p>
      </div>
      <div class="aandacht">
        <p><b>Studenten- of schoolsportvereniging?</b> Dan krijg je 40% korting: € 89, € 179 of € 329 per jaar voor Klein, Vereniging en Groot.</p>
      </div>
    </div>
  </section>

  <section class="vlak" id="regels">
    <div class="container"><div class="lees">
      <h2>Hoe de prijs werkt</h2>

      <h3>Wie telt als lid</h3>
      <p>Alleen de leden die in je ledenadministratie meetellen. Donateurs, ereleden zonder lidmaatschap, ouders met alleen een account voor hun kind en oud-leden tellen niet mee. Per lidsoort stel je zelf in of die meetelt.</p>

      <h3>Wanneer we tellen</h3>
      <p>Het abonnement loopt per kalenderjaar. We tellen je leden aan het begin van het jaar; groeit je vereniging in de loop van het jaar door een grens heen, dan verandert je prijs pas het jaar erop.</p>

      <h3>Betalen</h3>
      <p>Je krijgt één factuur per kalenderjaar.</p>

      <h3>Wat er altijd in zit</h3>
      <ul class="opsom">
        <li>Alle functies</li>
        <li>Zoveel beheerders als je wilt</li>
        <li>De app voor al je leden</li>
        <li>Nieuwe functies en updates</li>
        <li>Facturen, incasso’s en betaalbestanden zonder kosten per stuk</li>
        <li>Bonnen en facturen automatisch laten uitlezen, zonder limiet</li>
        <li>Hulp per e-mail en WhatsApp</li>
        <li>Het overzetten van je ledenlijst en je boekhouding</li>
      </ul>

      <h3>Wat er niet in zit</h3>
      <ul class="opsom kruis">
        <li>Maatwerk.</li>
        <li>Losse bonnen en mappen uitzoeken bij het overzetten. Lever je je ledenlijst, rekeningschema, beginbalans en bankmutaties aan als spreadsheet, dan is overzetten gratis. Moeten wij zelf gaan uitzoeken, dan spreken we vooraf een prijs af.</li>
      </ul>
    </div></div>
  </section>

  <section id="vragen">
    <div class="container">
      <h2>Vragen over de prijs</h2>
      <div class="faq">
        {
          vragen.map((v) => (
            <details>
              <summary><h3>{v.vraag}</h3></summary>
              <p set:html={v.antwoord} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="vlak" id="contact">
    <div class="container">
      <h2>Nog een vraag over de prijs?</h2>
      <p class="sectie-intro">Stuur een mail of een appje, dan krijg je persoonlijk antwoord.</p>
      <div class="cta-rij">
        <a class="knop" href="mailto:info@sporten.app">E-mail ons</a>
        <WhatsAppLink klasse="knop rand" tekst="WhatsApp ons" />
      </div>
    </div>
  </section>
</Basis>
