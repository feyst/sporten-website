---
import Basis from '../layouts/Basis.astro';

const basis = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

// Eén bron voor de vragen: de zichtbare FAQ en de FAQPage-markup komen allebei hieruit,
// zodat ze niet uit elkaar kunnen lopen.
const vragen = [
  {
    vraag: 'Wat als we een deel van de functies niet gebruiken?',
    antwoord:
      'Dan betaal je hetzelfde. De boekhouding staat klaar voor het moment dat je penningmeester eraan toe is.',
  },
  {
    vraag: 'Zitten er kosten per factuur of per incasso bij?',
    antwoord:
      'Nee. Je maakt zoveel facturen, incasso’s en betaalbestanden als je wilt. Wat je bank rekent voor een incasso of overboeking, betaal je aan je bank.',
  },
  {
    vraag: 'Wat gebeurt er met onze gegevens als we stoppen?',
    antwoord:
      'Je neemt alles mee. Per boekjaar download je het controlepakket met alle boekingen, grootboekkaarten, facturen, bankmutaties en de bonnen en afschriften die erbij horen. Je ledenlijst exporteer je als spreadsheet. Na opzegging krijg je de gegevens op verzoek van ons, en daarna verwijderen we ze.',
  },
  {
    vraag: 'Hoe lang zitten we eraan vast?',
    antwoord: 'Eén contractjaar. Daarna zeg je per jaar op, zonder boete.',
  },
  {
    vraag: 'We zijn een kleine vereniging met 40 leden. Is dit niet te zwaar?',
    antwoord:
      'Nee. Je begint met de ledenlijst en de agenda, en zet de boekhouding aan als je hem nodig hebt. Je betaalt € 149 per jaar, € 180,29 inclusief btw.',
  },
];

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: 'Sporten.app',
      description: 'Ledenadministratie, contributie en incasso, boekhouding en een ledenapp voor sportverenigingen, in één prijs naar het aantal leden.',
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'EUR',
        lowPrice: '149',
        highPrice: '799',
        offerCount: 4,
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: vragen.map((v) => ({
        '@type': 'Question',
        name: v.vraag,
        acceptedAnswer: { '@type': 'Answer', text: v.antwoord },
      })),
    },
  ],
});
---

<Basis
  titel="Wat kost Sporten.app? Prijzen voor je vereniging | Sporten.app"
  beschrijving="Ledenadministratie kosten voor je sportvereniging: één staffel vanaf € 149 per jaar, alle functies inbegrepen. Bekijk de prijzen van Sporten.app."
>
  <script type="application/ld+json" slot="kop" set:html={structuredData} />

  <div class="container kopblok"><div class="lees">
    <h1>Wat kost Sporten.app?</h1>
    <p>Je krijgt alle functies, in elke staffel. Wat je betaalt, hangt alleen af van het aantal leden.</p>
  </div></div>

  <section id="staffels">
    <div class="container">
      <div class="staffels">
        <div class="staffel">
          <p class="naam">Klein</p>
          <p class="omvang">t/m 100 leden</p>
          <p class="bedrag">€ 149</p>
          <p class="per">per jaar · excl. btw</p>
          <div class="incl">
            <span>€ 180,29 incl. btw</span><br />
            <span>€ 1,49 per lid bij 100 leden</span>
          </div>
        </div>
        <div class="staffel">
          <p class="naam">Vereniging</p>
          <p class="omvang">101 – 300 leden</p>
          <p class="bedrag">€ 299</p>
          <p class="per">per jaar · excl. btw</p>
          <div class="incl">
            <span>€ 361,79 incl. btw</span><br />
            <span>€ 1,00 per lid bij 300 leden</span>
          </div>
        </div>
        <div class="staffel">
          <p class="naam">Groot</p>
          <p class="omvang">301 – 750 leden</p>
          <p class="bedrag">€ 549</p>
          <p class="per">per jaar · excl. btw</p>
          <div class="incl">
            <span>€ 664,29 incl. btw</span><br />
            <span>€ 0,73 per lid bij 750 leden</span>
          </div>
        </div>
        <div class="staffel">
          <p class="naam">XL</p>
          <p class="omvang">vanaf 751 leden</p>
          <p class="bedrag">€ 0,70</p>
          <p class="per">per lid per jaar · min. € 799</p>
          <div class="incl">
            <span>€ 966,79 incl. btw bij het minimum</span>
          </div>
        </div>
      </div>

      <div class="aandacht">
        <p><b>Kan je vereniging de btw niet terugvragen?</b> Dat geldt voor de meeste sportverenigingen. Reken dan met het bedrag inclusief btw dat onder elke prijs staat.</p>
      </div>
      <div class="aandacht">
        <p><b>Studenten- of schoolsportvereniging?</b> Dan krijg je 40% korting: € 89, € 179 of € 329 per jaar voor Klein, Vereniging en Groot. Inclusief btw is dat € 107,69, € 216,59 of € 398,09.</p>
      </div>
    </div>
  </section>

  <section class="vlak" id="regels">
    <div class="container"><div class="lees">
      <h2>Hoe de prijs werkt</h2>

      <h3>Wie telt als lid</h3>
      <p>Alleen de leden die in je ledenadministratie meetellen. Donateurs, ereleden zonder lidmaatschap, ouders met alleen een account voor hun kind en oud-leden tellen niet mee. Per lidsoort stel je zelf in of die meetelt.</p>

      <h3>Wanneer we tellen</h3>
      <p>Eén keer per jaar, op de verlengdatum. Groeit je vereniging in de loop van het jaar door een grens heen, dan verandert je prijs pas bij de volgende verlenging.</p>

      <h3>Betalen</h3>
      <p>De bedragen gelden als je per jaar betaalt. Per maand betalen kan ook, met 10% toeslag.</p>

      <h3>Wat er altijd in zit</h3>
      <ul class="opsom">
        <li>Alle functies</li>
        <li>Zoveel beheerders als je wilt</li>
        <li>De app voor al je leden</li>
        <li>Nieuwe functies en updates</li>
        <li>Facturen, incasso’s en betaalbestanden zonder kosten per stuk</li>
        <li>Hulp per e-mail en WhatsApp</li>
        <li>Het overzetten van je boekhouding</li>
      </ul>

      <h3>Wat er niet in zit</h3>
      <ul class="opsom kruis">
        <li>Bonnen en facturen automatisch laten uitlezen, voor zover je meer dan 250 documenten per jaar gebruikt (100 in Klein). Wat je daarboven gebruikt, rekenen we door tegen de kosten die wij ervoor maken.</li>
        <li>Maatwerk.</li>
        <li>Losse bonnen en mappen uitzoeken bij het overzetten. Lever je je rekeningschema, beginbalans en bankmutaties aan als spreadsheet, dan is overzetten gratis. Moeten wij zelf gaan uitzoeken, dan spreken we vooraf een prijs af.</li>
      </ul>
    </div></div>
  </section>

  <section id="vragen">
    <div class="container">
      <h2>Vragen over de prijs</h2>
      <div class="faq">
        {
          vragen.map((v) => (
            <details>
              <summary><h3>{v.vraag}</h3></summary>
              <p set:html={v.antwoord} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="vlak" id="contact">
    <div class="container">
      <h2>Nog een vraag over de prijs?</h2>
      <p class="sectie-intro">Stuur een mail of een appje, dan krijg je persoonlijk antwoord.</p>
      <div class="cta-rij">
        <a class="knop" href="mailto:info@sporten.app">E-mail ons</a>
        <a class="knop rand" href="https://wa.me/31625002228">WhatsApp ons</a>
      </div>
    </div>
  </section>
</Basis>
