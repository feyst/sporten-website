---
import Basis from '../../layouts/Basis.astro';

const basis = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const titel = 'Boekhouding voor verenigingen | Sporten.app';
const beschrijving =
  'Boekhoudprogramma voor je sportvereniging: dubbel boekhouden, doorlopende nummering, jaarafsluiting, een boekjaar op elke datum en een controlepakket voor de kascommissie.';

const vragen = [
  {
    v: 'Kunnen we midden in het boekjaar overstappen?',
    a: 'Ja. Wij zetten je lopende boekjaar over op basis van je rekeningschema, beginbalans en bankmutaties. Je hoeft niet tot de jaarwisseling te wachten.',
  },
  {
    v: 'Ons boekjaar loopt van september tot augustus. Kan dat?',
    a: 'Ja. Een boekjaar begint en eindigt op de datum die je zelf kiest.',
  },
  {
    v: 'Kan onze kascommissie controleren zonder iets te kunnen wijzigen?',
    a: 'Ja. De kascommissie krijgt een eigen rol, die je per boekjaar toekent. Ze downloadt het controlepakket van dat jaar en kan niets aanpassen.',
  },
  {
    v: 'Krijgen we onze gegevens mee als we stoppen?',
    a: 'Ja. Per boekjaar download je het controlepakket met alle boekingen, grootboekkaarten, facturen, bankmutaties en de bonnen en afschriften die erbij horen. Dat kan op elk moment. Na opzegging leveren we de gegevens op verzoek terug voordat we ze verwijderen.',
  },
  {
    v: 'Moet ik verstand hebben van boekhouden?',
    a: 'Een beetje helpt, maar het hoeft niet je vak te zijn. Een declaratie of inkoopfactuur komt binnen met een voorstel voor de boeking, dat je alleen hoeft te controleren. En een boeking die niet in balans is, slaat Sporten.app niet op.',
  },
];

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: titel,
      description: beschrijving,
      url: 'https://sporten.app/functies/boekhouding',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sporten.app/' },
        { '@type': 'ListItem', position: 2, name: 'Functies', item: 'https://sporten.app/#functies' },
        { '@type': 'ListItem', position: 3, name: 'Boekhouding', item: 'https://sporten.app/functies/boekhouding' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: vragen.map(({ v, a }) => ({
        '@type': 'Question',
        name: v,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
});
---

<Basis titel={titel} beschrijving={beschrijving}>
  <script type="application/ld+json" slot="kop" set:html={structuredData} />

  <div class="container kopblok"><div class="lees">
    <p class="kruimels">
      <a href={basis}>Home</a><span>/</span><a href={`${basis}#functies`}>Functies</a><span>/</span>Boekhouding
    </p>

    <h1>Boekhouding voor verenigingen</h1>
    <p>
      Veel penningmeesters werken in Excel, en vaak gaat dat jaren goed. Maar een spreadsheet kun je
      achteraf aanpassen zonder dat iemand het ziet, en wie het na jou overneemt, moet eerst uitzoeken hoe
      jij werkte.
    </p>
    <p>
      Sporten.app geeft je een boekhouding met dezelfde regels als een boekhoudpakket. Het verschil: hij is
      aangesloten op de leden, facturen en activiteiten die je er al in hebt staan.
    </p>
  </div></div>

  <section>
    <div class="container">
      <h2>Wat je krijgt</h2>
      <div class="kaarten">
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 6c-2-2-5-2-9-1v14c4-1 7-1 9 1 2-2 5-2 9-1V5c-4-1-7-1-9 1z"/><path d="M12 6v14"/></svg></div>
          <h3>Dubbel boekhouden</h3>
          <p>Een grootboek met je eigen rekeningschema. Elke boeking raakt twee rekeningen en moet in balans zijn.</p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg></div>
          <h3>Boekjaren</h3>
          <p>Je boekjaar begint op de datum die bij je vereniging past, ook op 1 september. Je opent en sluit het zelf.</p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6h12M9 12h12M9 18h12"/><circle cx="4" cy="6" r="1.5"/><circle cx="4" cy="12" r="1.5"/><circle cx="4" cy="18" r="1.5"/></svg></div>
          <h3>Doorlopende nummering</h3>
          <p>Boekstukken, facturen en declaraties krijgen een nummer zonder gaten. Zo ziet de kascommissie meteen dat er niets ontbreekt.</p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></div>
          <h3>Vaste boekingen</h3>
          <p>Een geboekt stuk verandert niet meer. Een fout herstel je met een tegenboeking, zoals in elk boekhoudpakket.</p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10M10 20V4M16 20V14"/><path d="M2 20h20"/></svg></div>
          <h3>Balans en baten en lasten</h3>
          <p>Baten en lasten met de cijfers van vorig jaar en je begroting ernaast, en een balans op elke datum. Allebei te downloaden als Excel-bestand.</p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg></div>
          <h3>Jaarafsluiting</h3>
          <p>Kloppen de cijfers, dan sluit je het boekjaar af en verandert er niets meer aan. Is het toch nodig, dan open je het weer.</p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41 12 22l-9-9V4a1 1 0 0 1 1-1h9z"/><path d="M7 8h.01"/></svg></div>
          <h3>Kostenplaatsen</h3>
          <p>Zie per toernooi, kamp of activiteit wat het heeft gekost en opgeleverd, met een rapport in Excel of pdf.</p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r=".6" fill="currentColor"/></svg></div>
          <h3>Begroting</h3>
          <p>Zet een begroting neer en zie in de loop van het jaar of je op koers ligt.</p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/><path d="m9.5 13 1.5 1.5 3.5-3.5"/></svg></div>
          <h3>Controlepakket voor de kascommissie</h3>
          <p>Eén download met alle boekingen, grootboekkaarten, facturen en bankmutaties van het jaar, plus de bonnen en afschriften die erbij horen.</p>
        </div>
      </div>
      {/* Nog toe te voegen: schermafbeelding van de rapporten (balans en baten en lasten naast elkaar). */}
    </div>
  </section>

  <section class="vlak">
    <div class="container"><div class="lees">
      <h2>Een administratie die de kascommissie kan controleren</h2>
      <p>
        In een spreadsheet kun je een cel van vorige maand aanpassen zonder dat iemand het ziet. Hoe
        zorgvuldig je ook werkt, de kascommissie kan dat niet nagaan. In Sporten.app ligt het vast:
      </p>
      <ul class="opsom">
        <li>Een geboekt stuk kan niemand meer wijzigen.</li>
        <li>Facturen, declaraties en boekstukken zijn doorgenummerd, zonder gaten.</li>
        <li>Een boeking die niet in balans is, wordt niet opgeslagen.</li>
        <li>De kascommissie krijgt een eigen rol voor het jaar dat ze controleert. Ze downloadt het controlepakket en kan niets wijzigen.</li>
      </ul>
    </div></div>
  </section>

  <section>
    <div class="container"><div class="lees">
      <h2>Hoe het geld binnenkomt en weggaat</h2>
      <ul class="opsom">
        <li>Je stuurt contributiefacturen per mail, of je incasseert ze. Leden geven de machtiging zelf in de app.</li>
        <li>Je leest het bankafschrift in als CAMT.053-bestand, dat je bij je bank downloadt. Betalingen worden aan de facturen gekoppeld, en een teruggeboekte incasso komt vanzelf terug in je administratie.</li>
        <li>Een lid dient een declaratie in met een foto van de bon. Zet je automatisch uitlezen aan, dan staan winkel, datum en bedrag al ingevuld.</li>
        <li>Leveranciers mailen hun factuur naar een eigen adres van je vereniging, en je vindt hem terug als concept.</li>
        <li>Trainersvergoedingen stel je per periode vast. Je betaalt ze uit of verrekent ze met de contributie.</li>
        <li>Uitbetalingen en incasso’s zet je in een bestand dat je bij je bank aanlevert.</li>
      </ul>
    </div></div>
  </section>

  <section class="vlak">
    <div class="container"><div class="lees">
      <h2>Overstappen midden in het jaar</h2>
      <p>
        Je hoeft niet tot 1 januari te wachten. Je levert drie spreadsheets aan: je rekeningschema, de
        beginbalans en de bankmutaties tot nu toe. Wij lezen ze in en controleren of alles aansluit voordat we
        het definitief boeken. Overzetten zit in de <a href={`${basis}prijzen`}>prijs</a>.
      </p>
      <p>
        Incasseer je al via een ander pakket? Dan neem je je bestaande machtigingen mee.
      </p>
    </div></div>
  </section>

  <section>
    <div class="container"><div class="lees">
      <h2>Wat het niet is</h2>
      <ul class="opsom kruis">
        <li>Geen koppeling met je bank. Afschriften en betaalbestanden wissel je uit als bestand.</li>
        <li>Geen koppeling met een sportbond.</li>
        <li>Geen kantinekassa of webshop.</li>
        <li>Geen salarisadministratie.</li>
        <li>Geen btw-aangifte.</li>
      </ul>
    </div></div>
  </section>

  <section class="vlak">
    <div class="container">
      <h2>Vragen van penningmeesters</h2>
      <div class="faq">
        {vragen.map(({ v, a }) => (
          <details>
            <summary><h3>{v}</h3></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Zelf zien hoe het werkt?</h2>
      <p class="sectie-intro">Plan een half uur videobellen, dan laten we het je zien.</p>
      <div class="cta-rij">
        <a class="knop" href="mailto:info@sporten.app?subject=Videobellen%20over%20de%20boekhouding">Plan een gesprek</a>
        <a class="knop rand" href={`${basis}prijzen`}>Bekijk de prijzen</a>
      </div>
    </div>
  </section>
</Basis>
