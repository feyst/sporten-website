---
import Basis from '../../layouts/Basis.astro';
import WhatsAppLink from '../../components/WhatsAppLink.astro';

const basis = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const titel = 'Contributie innen met automatische incasso | Sporten.app';
const beschrijving =
  'Contributie innen voor je vereniging: facturen per mail, herinneringen en SEPA-incasso met machtiging in de app. Geen kosten per factuur of incasso.';

const vragen = [
  {
    v: 'Kan een lid kiezen om niet te machtigen?',
    a: 'Ja. Een lid kiest in de app voor een machtiging of voor "liever niet". In dat geval betaalt hij de factuur per overschrijving.',
  },
  {
    v: 'Hoe weet een lid wanneer er geïncasseerd wordt?',
    a: 'De factuur vermeldt de incassodatum en geldt als vooraankondiging. Een paar dagen voor de incasso krijgt het lid nog een bericht.',
  },
  {
    v: 'Kunnen we incasso later aanzetten?',
    a: 'Ja. Je zet het zelf aan zodra je het incassocontract met je bank hebt. Tot die tijd werk je met facturen en herinneringen.',
  },
];

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: titel,
      description: beschrijving,
      url: 'https://sporten.app/functies/contributie/',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sporten.app/' },
        { '@type': 'ListItem', position: 2, name: 'Functies', item: 'https://sporten.app/functies/' },
        { '@type': 'ListItem', position: 3, name: 'Contributie', item: 'https://sporten.app/functies/contributie/' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: vragen.map(({ v, a }) => ({
        '@type': 'Question',
        name: v,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
});
---

<Basis titel={titel} beschrijving={beschrijving}>
  <script type="application/ld+json" slot="kop" set:html={structuredData} />

  <div class="container kopblok"><div class="lees">
    <p class="kruimels">
      <a href={basis}>Home</a><span>/</span><a href={`${basis}functies/`}>Functies</a><span>/</span>Contributie
    </p>

    <h1>Contributie innen met automatische incasso</h1>
    <p>
      Bij de seizoensstart wil je de contributie innen zonder een avond af te vinken tegen het
      bankafschrift. Sporten.app maakt de contributiefacturen, stuurt ze per mail en herinnert leden die nog
      niet betaald hebben.
    </p>
    <p>
      Wil je automatisch incasseren, dan zet je dat zelf aan. De leden
      komen uit je <a href={`${basis}functies/ledenadministratie/`}>ledenadministratie</a>, de betalingen
      komen terecht in je <a href={`${basis}functies/boekhouding/`}>boekhouding</a>.
    </p>
  </div></div>

  <section>
    <div class="container">
      <h2>Facturen en herinneringen</h2>
      <div class="kaarten">
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></div>
          <h3>Contributie instellen</h3>
          <p>Je maakt je tarieven aan, met een prijs die ingaat op een datum die je kiest. Een nieuw tarief verandert niets aan facturen die al verstuurd zijn. De factuur gaat per mail naar het lid.</p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></div>
          <h3>Herinneringen</h3>
          <p>Wie na de vervaldatum nog niet betaald heeft, krijgt een herinnering. In het debiteurenoverzicht zie je welke facturen openstaan.</p>
        </div>
        <div class="kaart">
          <div class="ikoon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg></div>
          <h3>Betalingen bij de juiste factuur</h3>
          <p>Je leest het bankafschrift in als CAMT.053-bestand; de meeste Nederlandse banken bieden dat aan. Sporten.app herkent de betalingen en stelt de bijbehorende factuur voor; je bevestigt met één klik.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="vlak">
    <div class="container"><div class="lees">
      <h2>Automatische incasso voor je vereniging</h2>
      <p>SEPA-incasso zet je zelf aan.</p>
      <h3>Wat je zelf regelt</h3>
      <ul class="opsom">
        <li>Bij je bank vraag je een incassocontract en een incassant-ID aan.</li>
        <li>In Sporten.app zet je de incasso aan.</li>
        <li>Heeft een lid een papieren machtiging getekend, dan leg je die vast.</li>
        <li>Het incassobestand lever je aan bij je bank.</li>
      </ul>
      <h3>Wat Sporten.app doet</h3>
      <ul class="opsom">
        <li>Leden geven de machtiging zelf in de app. Wie dat liever niet wil, kiest "liever niet".</li>
        <li>Leden die nog niets hebben gedaan, nodig je per mail uit om te machtigen.</li>
        <li>Incasseerde je al met een ander pakket? Dan neem je je bestaande machtigingen mee. Lees meer over <a href={`${basis}overstappen/`}>overstappen</a>.</li>
        <li>Sporten.app maakt het incassobestand.</li>
        <li>De contributiefactuur geldt als vooraankondiging en vermeldt de incassodatum. Een paar dagen voor de incasso krijgt het lid nog een bericht.</li>
      </ul>
    </div></div>
  </section>

  <section>
    <div class="container"><div class="lees">
      <h2>Als een incasso niet lukt</h2>
      <p>
        Soms lukt een incasso niet, bijvoorbeeld door een leeg saldo of omdat een lid terugboekt. Lees je het bankafschrift in, dan ziet
        Sporten.app de teruggeboekte betaling. De factuur staat weer open en het lid krijgt een mail.
      </p>
      <p>
        Lukt de incasso niet, dan kun je de factuur omzetten naar overschrijving.
      </p>
    </div></div>
  </section>

  <section class="vlak">
    <div class="container"><div class="lees">
      <h2>Geen kosten per factuur of incasso</h2>
      <p>
        Het bedrag per jaar hangt af van het aantal leden en
        staat op de <a href={`${basis}prijzen/`}>prijzenpagina</a>.
      </p>
    </div></div>
  </section>

  <section>
    <div class="container"><div class="lees">
      <h2>Wat je met je bank uitwisselt</h2>
      <ul class="opsom kruis">
        <li>Geen koppeling met je bank. Het incassobestand en het bankafschrift wissel je met je bank uit als bestand.</li>
        <li>Geen iDEAL-betaallink bij de factuur.</li>
      </ul>
    </div></div>
  </section>

  <section class="vlak">
    <div class="container">
      <h2>Vragen van penningmeesters</h2>
      <div class="faq">
        {vragen.map(({ v, a }) => (
          <details>
            <summary><h3>{v}</h3></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <h2>Zelf zien hoe het werkt?</h2>
      <p class="sectie-intro">Plan een half uur videobellen, dan laten we de contributie in Sporten.app zien.</p>
      <div class="cta-rij">
        <a class="knop" href="mailto:info@sporten.app?subject=Videobellen%20over%20contributie%20en%20incasso">Plan een gesprek</a>
        <a class="knop rand" href={`${basis}prijzen/`}>Bekijk de prijzen</a>
        <WhatsAppLink klasse="knop rand" tekst="WhatsApp ons" />
      </div>
    </div>
  </section>
</Basis>
